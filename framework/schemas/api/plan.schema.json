{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev-crew/schemas/api/plan.schema.json",
  "title": "Plan (orchestrator -> main thread)",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "objective", "lang", "outfile", "tasks", "synthesis"],
  "properties": {
    "apiVersion": { "type": "string", "const": "1.0.0" },
    "objective": { "type": "string" },
    "lang": { "type": "string", "enum": ["fr", "en", "both"] },
    "outfile": { "type": "string" },
    "tokenBudget": { "type": "number" },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "capabilities", "brief"],
        "properties": {
          "id": { "type": "string" },
          "capabilities": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "resolvedSkillId": { "type": "string", "description": "rempli après résolution via registry" },
          "brief": { "type": "string" },
          "needs": { "type": "array", "items": { "type": "string" }, "description": "v1 ; alias de dependencies" },
          "dependencies": { "type": "array", "items": { "type": "string" }, "description": "ADR-023 (additif) ; équivalent de needs" },
          "parallelGroup": { "type": "integer", "description": "déprécié — le scheduler dérive le parallélisme du DAG" },
          "priority": { "type": "integer" },
          "estimatedCost": { "type": "number" },
          "estimatedTokens": { "type": "number" },
          "estimatedDuration": { "type": "number" },
          "qualityTarget": { "type": "integer", "minimum": 0, "maximum": 100 },
          "requiredKnowledge": { "type": "array", "items": { "type": "string" } },
          "files": { "type": "array", "items": { "type": "string" } },
          "produces": { "type": "string" }
        }
      }
    },
    "synthesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outfile"],
      "properties": { "outfile": { "type": "string" }, "instructions": { "type": "string" } }
    }
  }
}
