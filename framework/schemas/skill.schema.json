{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev-crew/schemas/skill.schema.json",
  "title": "Skill manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "description", "category", "capabilities", "outputs", "entry", "compatibility"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$", "description": "category.slug, ex: engineering.frontend" },
    "name": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "name": { "type": "string" }, "email": { "type": "string" } }
    },
    "author": { "type": "string" },
    "description": { "type": "string", "minLength": 10 },
    "category": { "type": "string", "enum": ["engineering", "design", "operations", "quality", "documentation", "ai"] },
    "tags": { "type": "array", "items": { "type": "string" } },
    "capabilities": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "range"],
        "properties": { "capability": { "type": "string" }, "range": { "type": "string" } }
      }
    },
    "priority": { "type": "integer", "minimum": 0, "maximum": 100 },
    "estimatedCost": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "unit": { "type": "string" }, "typical": { "type": "number" } }
    },
    "qualityLevel": { "type": "string", "enum": ["draft", "beta", "stable"] },
    "maturityLevel": { "type": "string", "enum": ["experimental", "beta", "stable", "deprecated"] },
    "recommendedModels": { "type": "array", "items": { "type": "string" } },
    "inputs": { "type": "array", "items": { "type": "string" } },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outputFormat"],
      "properties": {
        "outputFormat": { "type": "string", "enum": ["markdown", "json", "yaml"] },
        "sections": { "type": "array", "items": { "type": "string" } }
      }
    },
    "compatibleCommands": { "type": "array", "items": { "type": "string" } },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["framework"],
      "properties": { "framework": { "type": "string" } }
    },
    "knowledge": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "capabilities"],
        "properties": {
          "file": { "type": "string" },
          "capabilities": { "type": "array", "items": { "type": "string" } },
          "tokensApprox": { "type": "number" }
        }
      }
    },
    "examples": { "type": "array", "items": { "type": "string" } },
    "documentation": { "type": "string" },
    "entry": { "type": "string", "description": "SKILL.md relatif au dossier du skill" }
  }
}
