{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev-crew/schemas/meta/tech-debt-report.schema.json",
  "title": "TechDebtReport (Technical Debt Engine, ADR-072)",
  "type": "object",
  "required": ["metaApiVersion", "generatedAt", "items"],
  "properties": {
    "metaApiVersion": { "type": "string", "const": "1.0.0" },
    "generatedAt": { "type": "string" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "target", "severity"],
        "properties": {
          "type": { "type": "string" },
          "target": { "type": "string" },
          "severity": { "type": "string", "enum": ["low", "medium", "high"] },
          "evidence": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
