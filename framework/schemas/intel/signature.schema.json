{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev-crew/schemas/intel/signature.schema.json",
  "title": "Signature (Technology / Architecture Detector, déclaratif)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "confidence", "match"],
  "properties": {
    "id": { "type": "string" },
    "style": { "type": "string", "description": "pour les signatures d'architecture" },
    "provides": { "type": "array", "items": { "type": "string" }, "description": "capacités/technos fournies" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "extensions": { "type": "array", "items": { "type": "string" } },
        "files": { "type": "array", "items": { "type": "string" } },
        "pathContains": { "type": "array", "items": { "type": "string" } },
        "depsAny": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
