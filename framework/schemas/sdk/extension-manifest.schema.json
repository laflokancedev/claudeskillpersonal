{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev-crew/schemas/sdk/extension-manifest.schema.json",
  "title": "Extension Manifest (extension.json, ADR-052)",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "sdk", "sdkApiVersion"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "kind": { "type": "string", "enum": ["extension", "pack"] },
    "sdk": { "type": "string", "description": "plage semver compatible du SDK" },
    "sdkApiVersion": { "type": "string" },
    "author": { "type": "string" },
    "license": { "type": "string" },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "range"],
        "properties": { "name": { "type": "string" }, "range": { "type": "string" } }
      }
    },
    "capabilities": { "type": "array", "items": { "type": "string" } },
    "provides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skills": { "type": "array", "items": { "type": "string" } },
        "commands": { "type": "array", "items": { "type": "string" } },
        "workflows": { "type": "array", "items": { "type": "string" } },
        "templates": { "type": "array", "items": { "type": "string" } },
        "policies": { "type": "array", "items": { "type": "string" } },
        "signatures": { "type": "array", "items": { "type": "string" } },
        "routers": { "type": "array", "items": { "type": "string" } },
        "validators": { "type": "array", "items": { "type": "string" } },
        "agents": { "type": "array", "items": { "type": "string" } }
      }
    },
    "hooks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "handler"],
        "properties": {
          "name": { "type": "string" },
          "handler": { "type": "string" },
          "priority": { "type": "integer" }
        }
      }
    },
    "permissions": { "type": "array", "items": { "type": "string" } },
    "assets": { "type": "array", "items": { "type": "string" } }
  }
}
