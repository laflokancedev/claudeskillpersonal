{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev-crew/schemas/workflow.schema.json",
  "title": "Workflow definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "description", "steps", "merge"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "description": { "type": "string" },
    "compatibility": {
      "type": "object",
      "properties": { "framework": { "type": "string" } }
    },
    "inputs": { "type": "array", "items": { "type": "string" } },
    "tokenBudget": {
      "type": "object",
      "properties": { "perRun": { "type": "number" }, "perStep": { "type": "number" } }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "uses"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "uses": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "capacités requises" },
          "with": { "type": "object" },
          "needs": { "type": "array", "items": { "type": "string" } },
          "parallelGroup": { "type": "integer", "minimum": 1 },
          "when": { "type": "string" },
          "produces": { "type": "string" }
        }
      }
    },
    "merge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent", "outfile"],
      "properties": { "agent": { "type": "string" }, "outfile": { "type": "string" } }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent": { "type": "string" },
        "gates": { "type": "object", "additionalProperties": { "type": "integer" } },
        "maxReplan": { "type": "integer", "minimum": 0 }
      }
    },
    "rollback": { "type": "object" },
    "onError": { "type": "object" }
  }
}
